# ===== code-rag =====
# Copie para .env (make setup faz isso automaticamente)

# Perfis do docker compose: coloque "ollama" para subir o container do Ollama junto.
# Vazio = sem container extra (fastembed roda dentro do próprio servidor).
COMPOSE_PROFILES=

# --- Embeddings (agnóstico) ---
# Provider: fastembed | ollama | openai | gemini
#
# fastembed (padrão): roda DENTRO do container do servidor (ONNX, CPU),
# sem nenhum serviço externo. O modelo baixa do Hugging Face na 1ª indexação.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Melhor para código (768d, ~640MB): jinaai/jina-embeddings-v2-base-code
# EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

EMBEDDING_BATCH_SIZE=64
# Batches processados em paralelo (todos os providers). Para APIs (ollama/openai/
# gemini) valores maiores aceleram bastante; para fastembed (CPU) 2-4 é o ideal.
EMBEDDING_CONCURRENCY=4

# Prefixos de tarefa (opcionais — alguns modelos melhoram com eles).
# As aspas preservam o espaço final:
EMBEDDING_DOC_PREFIX=""
EMBEDDING_QUERY_PREFIX=""

# --- Ollama ---
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DOC_PREFIX="search_document: "
# EMBEDDING_QUERY_PREFIX="search_query: "
# Container do compose (requer COMPOSE_PROFILES=ollama e ~4GB de disco no Docker):
# OLLAMA_URL=http://ollama:11434
# Ollama instalado no host (macOS):
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434

# --- OpenAI-compatible (OpenAI, LM Studio, vLLM, Together...) ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# --- Gemini ---
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_API_KEY=...
# GEMINI_OUTPUT_DIM=768
